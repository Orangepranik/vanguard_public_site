# Caddy — реверс-проксі з автоматичним HTTPS (Let's Encrypt) для VANGUARD.
# Потрібні: A-записи ursvanguard.com і www → IP сервера, відкриті порти 80 і 443.
# Якщо домен інший — заміни його тут.

ursvanguard.com, www.ursvanguard.com {
	encode gzip zstd

	# Внутрішні метрики — закрити від публічного доступу. handle гарантує порядок:
	# /api/metrics → 404 ще ДО того, як reverse_proxy перехопить решту (інакше проксі ловить усе).
	# Prometheus скрейпить site:3000/api/metrics усередині Docker-мережі — йому доступ лишається.
	handle /api/metrics {
		respond 404
	}
	handle {
		reverse_proxy site:3000
	}
}

# Grafana — окремий піддомен з авто-HTTPS. Доступ із будь-якого пристрою за логіном Grafana.
# Потрібна DNS A-запис: grafana.ursvanguard.com → IP сервера (169.58.92.166).
grafana.ursvanguard.com {
	# Cloudflare у режимі Full шифрує до origin, але НЕ валідує сертифікат — тому Caddy
	# віддає власний self-signed (internal). Так не потрібен Let's Encrypt, який за
	# Cloudflare-проксі не проходить ACME-челендж (звідси й була помилка 525).
	tls internal
	encode gzip zstd
	reverse_proxy vanguard-grafana:3000
}
