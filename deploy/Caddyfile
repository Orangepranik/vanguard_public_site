# Caddy — реверс-проксі з автоматичним HTTPS (Let's Encrypt) для VANGUARD.
# Потрібні: A-записи ursvanguard.com і www → IP сервера, відкриті порти 80 і 443.
# Якщо домен інший — заміни його тут.

ursvanguard.com, www.ursvanguard.com {
	encode gzip zstd

	# Внутрішні метрики Prometheus — закрити від публічного доступу.
	# Prometheus скрейпить site:3000/api/metrics усередині Docker-мережі, повз Caddy.
	@metrics path /api/metrics
	respond @metrics 404

	reverse_proxy site:3000
}
