# Скопіювати у deploy/.env і заповнити реальними значеннями.
# deploy/.env — із секретами, НЕ комітиться (deploy/.gitignore).

# Пароль PostgreSQL. ВАЖЛИВО: лише латиниця/цифри, без символів @ : / #
# (значення підставляється в DATABASE_URL без екранування).
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Секрет для POST /api/revalidate (будь-який довгий випадковий рядок).
REVALIDATE_SECRET=REPLACE_WITH_RANDOM_SECRET

# Telegram-сповіщення про заявки (бот від @BotFather + chat_id менеджера).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
